# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.
# Do not commit real tokens.

# Prometheus that scrapes windows_exporter / node_exporter / snmp / vmware / redfish exporters
PROMETHEUS_URL=https://fs-le-dev-prometheus.finspot.in
PROMETHEUS_TOKEN=
# Label that carries the client id on every series, if your Prometheus has one (e.g. tenant)
PROMETHEUS_TENANT_LABEL=

# Loki with Windows Event Logs / journald
LOKI_URL=
LOKI_TOKEN=
LOKI_ORG_ID=
# Stream label holding the server's hostname (host, hostname or instance)
LOKI_HOST_LABEL=host
LOKI_TENANT_LABEL=

# Development only: draw labelled sample graphs while PROMETHEUS_URL / LOKI_URL
# are unset (default on when DJANGO_DEBUG=1, always off in production)
METRICS_SAMPLE_DATA=1
